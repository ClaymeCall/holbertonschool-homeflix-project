# HomeFlix configuration.
# Copy this file to `.env` and fill in the empty values. Never commit `.env`.
#
# Generate a random password with:  tr -dc a-f0-9 < /dev/urandom | head -c 32; echo
# Use letters and digits only (hex is fine) in the passwords below.

# --- Database (PostgreSQL) ---
POSTGRES_USER=homeflix_admin
POSTGRES_PASSWORD=
IDENTITY_DB_PASSWORD=
LIBRARY_DB_PASSWORD=
ACQUISITION_DB_PASSWORD=

# --- Session (identity service) ---
# Path of the RSA private key that signs session tokens (ADR-0009). The file is mounted
# into the identity service only. Keep it secret: anyone who has it can sign in as any
# account. The secrets/ folder is ignored by git. Generate the key pair once with:
#   mkdir -p secrets && chmod 700 secrets
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out secrets/jwt-private.pem
#   openssl pkey -in secrets/jwt-private.pem -pubout -out secrets/jwt-public.pem
#   chmod 644 secrets/jwt-private.pem
# The service runs as a non-root user inside its container, so it needs read access to the
# file (644); the folder (700) keeps other users of the host out. A new key signs everyone out.
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
# Matching public key (second openssl command above), given to the library and acquisition
# services so they can check tokens. Not a secret, but it must match the private key.
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem

# --- Calls between services (ADR-0022) ---
# Secret the identity service sends to the library (header X-Service-Token), for example
# to delete a profile's favourites and progress. Random, letters and digits only:
#   tr -dc a-f0-9 < /dev/urandom | head -c 32; echo
IDENTITY_TO_LIBRARY_TOKEN=

# --- Media ---
# Folder with your videos. Mounted READ-ONLY into the library service.
MEDIA_LIBRARY_PATH=./data/library
# Folder where completed downloads are written (separate from your library).
DOWNLOADS_PATH=./data/downloads

# --- Access ---
# Host port where HomeFlix is reachable: http://localhost:8080
GATEWAY_PORT=8080

# --- qBittorrent container ---
# User and group IDs that own downloaded files (run `id -u` and `id -g`).
PUID=1000
PGID=1000
TZ=Europe/Paris
# Login of the torrent client's web interface and API. Only the acquisition service uses it: the
# interface is never published. There is no default: qBittorrent does not start without them.
# Password: at least 12 characters, letters and digits (generate one with the command at the top).
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
# BitTorrent peer port, published on the host so other peers can connect (TCP and UDP). For incoming
# connections from the Internet, forward this port on your router to this computer.
QBITTORRENT_PEER_PORT=6881
# Seeding stops when either limit is reached: share ratio (uploaded / downloaded) or minutes of seeding.
QBITTORRENT_MAX_RATIO=1.0
QBITTORRENT_MAX_SEEDING_MINUTES=60
