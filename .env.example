# HomeFlix configuration.
# Copy this file to `.env` and fill in the empty values. Never commit `.env`.
#
# Generate a random password with:  tr -dc a-f0-9 < /dev/urandom | head -c 32; echo
# Use letters and digits only (hex is fine) in the passwords below.

# --- Database (PostgreSQL) ---
POSTGRES_USER=homeflix_admin
POSTGRES_PASSWORD=
IDENTITY_DB_PASSWORD=
LIBRARY_DB_PASSWORD=
ACQUISITION_DB_PASSWORD=

# --- Session (identity service) ---
# RSA private key that signs the session token (ADR-0009). Keep it secret: anyone who
# has it can sign in as any account. Generate it as ONE line with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | openssl base64 -A; echo
# Changing it signs everyone out.
JWT_PRIVATE_KEY=

# --- Media ---
# Folder with your videos. Mounted READ-ONLY into the library service.
MEDIA_LIBRARY_PATH=./data/library
# Folder where completed downloads are written (separate from your library).
DOWNLOADS_PATH=./data/downloads

# --- Access ---
# Host port where HomeFlix is reachable: http://localhost:8080
GATEWAY_PORT=8080

# --- qBittorrent container ---
# User and group IDs that own downloaded files (run `id -u` and `id -g`).
PUID=1000
PGID=1000
TZ=Europe/Paris
